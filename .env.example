# Copie para .env na raiz do projeto (nunca commite o arquivo .env)
# Obtenha a chave em: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Opcional: modelo na API Gemini (padrão: gemini-2.5-flash). Modelos antigos como gemini-1.5-flash podem retornar 404.
# GEMINI_MODEL=gemini-2.0-flash

# Opcional: origens permitidas no CORS (separadas por vírgula).
# Em desenvolvimento, localhost é aceito por padrão.
# Exemplo de produção:
# CORS_ORIGINS=https://seu-dominio.vercel.app,https://www.seudominio.com

# Opcional: defina 1 para logs de debug do Flask (não use em produção pública)
# FLASK_DEBUG=1
