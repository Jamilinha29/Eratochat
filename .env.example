# ==========================================================
# PASSO A PASSO DE CONFIGURACAO LOCAL
# ==========================================================
# 1) Copie este arquivo para .env
#    - Windows (CMD): copy .env.example .env
#    - Linux/macOS:   cp .env.example .env
#
# 2) Preencha os valores obrigatorios abaixo.
#
# 3) Se voce JA tem .env pronto, pode ignorar este arquivo.
# ==========================================================

# Obrigatorio: chave Gemini
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Opcional: modelo Gemini (padrao recomendado)
GEMINI_MODEL=gemini-3-flash

# Limites basicos da API
MAX_MESSAGE_CHARS=1200
RATE_LIMIT_MAX_REQUESTS=25
RATE_LIMIT_WINDOW_SECONDS=60

# Opcional: token adicional para proteger /api/chat
APP_AUTH_TOKEN=

# CORS para desenvolvimento local
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001,http://127.0.0.1:5173,http://localhost:5173

# Opcional: Supabase para logs reais de metricas
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_METRICS_TABLE=api_request_metrics

# Debug local (em producao, use 0)
FLASK_DEBUG=1
