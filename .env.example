# Copie para .env na raiz do projeto (nunca commite o arquivo .env)
# Obtenha a chave em: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Opcional: modelo na API Gemini (padrão: gemini-3-flash). Modelos antigos como gemini-1.5-flash podem retornar 404.
# GEMINI_MODEL=gemini-3-flash

# Opcional: limite de caracteres por mensagem (anti-abuso)
# MAX_MESSAGE_CHARS=1200

# Opcional: rate limit básico por IP
# RATE_LIMIT_MAX_REQUESTS=25
# RATE_LIMIT_WINDOW_SECONDS=60

# Opcional: proteção adicional da API. Se definido, enviar:
# Authorization: Bearer <APP_AUTH_TOKEN>
# ou header X-App-Token: <APP_AUTH_TOKEN>
# APP_AUTH_TOKEN=

# Opcional: origens permitidas no CORS (separadas por vírgula).
# Em desenvolvimento, localhost é aceito por padrão.
# Exemplo de produção:
# CORS_ORIGINS=https://seu-dominio.vercel.app,https://www.seudominio.com

# Opcional: defina 1 para logs de debug do Flask (não use em produção pública)
# FLASK_DEBUG=1
